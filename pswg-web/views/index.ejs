<%- include('partials/top') %>

<style>
  main {
    width: 100%;
    height: 100%;
    padding: 3rem 0;
  }

  .top {
    position: relative;
    text-align: center;
    padding: 0 2rem;
    transform: translateY(80%);
  }

  .top > div {
    display: inline-block;
  }

  .top > div > div {
    display: flex;
    justify-content: space-between;
  }

  .soon {
    margin-left: auto;
    font-size: 1rem;
  }

  .register-form {
    position: absolute;
    top: 35%;
    left: 50%;
    width: 300px;
    padding: 1.25rem;
    border-radius: 2px;
    background-color: rgba(0,0,0,.95);
    border: 1px solid rgba(255,255,255,.1);
    backdrop-filter: blur(4px);
    transform: translate(-50%, -50%);
    box-shadow: rgba(0, 0, 0, 0.25) 0px 54px 55px, rgba(0, 0, 0, 0.12) 0px -12px 30px, rgba(0, 0, 0, 0.12) 0px 4px 6px, rgba(0, 0, 0, 0.17) 0px 12px 13px, rgba(0, 0, 0, 0.09) 0px -3px 5px;
    z-index: 10;

    transition: .2s ease-in-out;
    opacity: 0;
    transform: translate(-50%, -45%);
    pointer-events: none;
  }

  .register-form.active {
    opacity: 1;
    transform: translate(-50%, -50%);
    pointer-events: all;
  }

  .register-form span {
    display: block;
    margin-bottom: .69rem;
    font-size: 1.2rem;
  }

  form {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  form label {
    font-family: var(--ff-roboto);
    font-size: .85rem;
  }

  form input:not(input[type="submit"]) {
    width: 100%;
    background: rgba(255,255,255,.169);
    padding: 2px 4px;
    color: var(--c-white);
    border-radius: 2px;
    border-bottom: 1px solid transparent;
  }

  form input:not(input[type="submit"]):focus-visible {
    background-color: transparent;
    border-bottom: 1px solid var(--c-white);
    border-radius: 0;
  }

  form input[type="submit"]:active {
    box-shadow: inset 0 0 8px 3px var(--c-black);
  }

  form fieldset {
    margin-bottom: .45rem;
  }

  form input[type="submit"] {
    margin-top: 1rem;
    width: auto;
    margin: 1rem auto 0 0;
  }

  form .error,
  form .success {
    font-size: .9rem;
    font-weight: bold;
    color: var(--c-red);
  }

  form .success {
    color: var(--c-green);
  }

  .register-form .loading {
    display: none;
    justify-content: center;
    margin: 1rem 0 .5rem;
  }

  .register-form.loading .loading {
    display: flex;
  }

  .register-form.loading label,
  .register-form.loading input {
    opacity: .2;
    pointer-events: none;
  }
</style>

<body>
  <main>
    <div class="top">
      <div>
        <img src="/logo.png" alt="">
        <div>
          <%if(canRegister) { %>
            <a class="register" href="#register">Register Account</a>
          <% } %>
          <span class="soon">Coming Soon...</span>
        </div>
      </div>
    </div>
  </main>

  <div class="register-form">
    <span>Register Game Account</span>

    <form id="register" disabled="<%= !canRegister%>">
      <fieldset>
        <label for="username">Username</label>
        <input type="text" name="username" id="username">
      </fieldset>
      <fieldset>
        <label for="password">Password</label>
        <input type="password" name="password" id="password" autocomplete="new-password">
      </fieldset>
      <fieldset>
        <label for="passwordConfirm">Confirm Password</label>
        <input type="password" name="passwordConfirm" id="passwordConfirm" autocomplete="new-password">
      </fieldset>
      <div class="error"></div>
      <div class="success"></div>
      <div class="loading">
        <div class="loader"></div>
      </div>
      <input class="button" type="submit" value="Register">
    </form>
  </div>

  <script nonce="<%= nonce %>">
    document.addEventListener('DOMContentLoaded', () => {
      const openEl = document.querySelector('a[href="#register"]');
      const registerWrapper = document.querySelector('.register-form');
      const registerForm = document.getElementById('register');
      const successEl = registerForm.querySelector('.success');
      const errorEl = registerForm.querySelector('.error');
      const canRegister = registerForm.getAttribute('disabled');

      if(openEl) {
        openEl.addEventListener('click', () => {
          registerWrapper.classList.add('active');
        });
  
        document.addEventListener('click', (e) => {
          if(e.target !== openEl && !e.target.closest('.register-form')) registerWrapper.classList.remove('active')
        });
  
        document.addEventListener('keydown', (e) => {
          if(e.key === 'Escape') registerWrapper.classList.remove('active')
        });
      }

      function error(clear, message) {
        if(clear) {
          errorEl.innerText = '';
          errorEl.classList.add('hide');
        } else {
          errorEl.innerText = `Error: ${message}`;
          errorEl.classList.remove('hide');
        }

        registerWrapper.classList.remove('loading');
      }

      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if(!canRegister) {
          error(false, 'Registration is currently disabled');
          return;
        }

        const formData = new FormData(registerForm);
        const formJSON = Object.fromEntries(formData);

        const username = formJSON.username.toLowerCase().trim();
        const password = formJSON.password.trim();
        const passwordConfirm = formJSON.passwordConfirm.trim();

        if(username.length < 3) {
          error(false, 'Username must be at least 3 characters');
        } else if(password.length < 8) {
          error(false, 'Password must be at least 8 characters');
        } else if(password !== passwordConfirm) {
          error(false, 'Passwords do not match');
        } else {
          try {
            error(true);
            registerWrapper.classList.add('loading');

            const response = await fetch('http://localhost:3000/register', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formJSON),
            });

            if (!response.ok) {
              const errorText = await response.text();
              error(false, errorText);
              throw new Error(`Registration error ${response.status}: ${errorText}`);
            }

            const responseData = await response.json(); // Parse the JSON response
            registerWrapper.classList.remove('loading');
            successEl.innerText = `You're all set, ${formJSON.username}\n You can now log into pSWG`;
          } catch(err) {
            console.error('Error posting registration form: ', err);
            error(false, 'Registration error - try again later');
          }
        }
        console.log(formJSON);
      });
    });
  </script>
<%- include('partials/bottom') %>